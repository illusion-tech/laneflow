{
  "formatVersion": "0.10",
  "units": {
    "distance": "meter",
    "time": "second"
  },
  "laneGraph": {
    "edges": [
      {
        "id": "entry",
        "length": 10.0,
        "speedLimit": 10.0,
        "connections": [{ "toEdgeId": "internal-a" }]
      },
      {
        "id": "internal-a",
        "length": 6.0,
        "speedLimit": 10.0,
        "connections": [{ "toEdgeId": "internal-b" }]
      },
      {
        "id": "internal-b",
        "length": 7.0,
        "speedLimit": 10.0,
        "connections": [{ "toEdgeId": "exit" }]
      },
      {
        "id": "exit",
        "length": 10.0,
        "speedLimit": 10.0,
        "connections": []
      }
    ]
  },
  "junctions": [{ "id": "junction" }],
  "movements": [{ "id": "movement", "junctionId": "junction" }],
  "maneuverPaths": [
    {
      "id": "path",
      "movementId": "movement",
      "entryEdgeId": "entry",
      "internalEdgeIds": ["internal-a", "internal-b"],
      "exitEdgeId": "exit"
    }
  ],
  "routes": [
    {
      "id": "route",
      "edgeIds": ["entry", "internal-a", "internal-b", "exit"]
    }
  ],
  "vehicleProfiles": [
    {
      "id": "passenger-car",
      "length": 5.0,
      "model": "iidm",
      "desiredSpeed": 10.0,
      "minGap": 2.0,
      "timeHeadway": 1.5,
      "maxAcceleration": 1.5,
      "comfortableDeceleration": 2.0,
      "emergencyDeceleration": 6.0,
      "participantClassId": "car"
    }
  ],
  "participantClasses": [{ "id": "car" }],
  "facilityBands": [],
  "roadSections": [],
  "laneGroups": [],
  "roadCorridors": [],
  "accessRules": [],
  "waitingZones": [
    {
      "id": "zone-b",
      "maneuverPathId": "path",
      "entryGateId": "gate-middle",
      "releaseGateId": "gate-release",
      "maxOccupancy": 1
    },
    {
      "id": "zone-a",
      "maneuverPathId": "path",
      "entryGateId": "gate-entry",
      "releaseGateId": "gate-middle",
      "maxOccupancy": 2
    }
  ],
  "signals": {
    "stopLines": [
      {
        "id": "stop-entry",
        "edgeId": "entry",
        "location": "edgeEnd"
      },
      {
        "id": "stop-middle",
        "edgeId": "internal-a",
        "location": "edgeEnd"
      },
      {
        "id": "stop-release",
        "edgeId": "internal-b",
        "location": "edgeEnd"
      }
    ],
    "maneuverGates": [
      {
        "id": "gate-release",
        "maneuverPathId": "path",
        "transitionIndex": 2,
        "stopLineId": "stop-release",
        "signalControl": { "kind": "none" }
      },
      {
        "id": "gate-middle",
        "maneuverPathId": "path",
        "transitionIndex": 1,
        "stopLineId": "stop-middle",
        "signalControl": { "kind": "none" }
      },
      {
        "id": "gate-entry",
        "maneuverPathId": "path",
        "transitionIndex": 0,
        "stopLineId": "stop-entry",
        "signalControl": { "kind": "none" }
      }
    ],
    "groups": [],
    "controllers": []
  },
  "parking": {
    "areas": [],
    "spaces": []
  }
}
