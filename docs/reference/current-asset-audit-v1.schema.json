{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/illusion-tech/laneflow/blob/main/docs/reference/current-asset-audit-v1.schema.json",
  "title": "LaneFlow current asset audit v1",
  "description": "#297 current v0.10 仓库资产、空的已发布资产范围、迁移分类、结构化失败与 cleanup 责任。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "profiles",
    "source",
    "inventorySources",
    "inventoryDigest",
    "assets",
    "overallStatus",
    "cleanup"
  ],
  "properties": {
    "schema": {
      "const": "laneflow.current-asset-audit"
    },
    "schemaVersion": {
      "const": 1
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "compiler",
        "publishedInventory"
      ],
      "properties": {
        "source": {
          "const": "LF-CURRENT-SOURCE-P100-IMPORT-v1"
        },
        "compiler": {
          "type": "string",
          "pattern": "^LF-COMP-P100-INITIAL-v([2-9]|[1-9][0-9]+)$"
        },
        "publishedInventory": {
          "const": "LF-CURRENT-PUBLISHED-INVENTORY-v1"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "dirty"
      ],
      "properties": {
        "commit": {
          "$ref": "#/$defs/gitObjectId"
        },
        "dirty": {
          "const": false
        }
      }
    },
    "inventorySources": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/repositoryInventory"
        },
        {
          "$ref": "#/$defs/publishedInventory"
        }
      ],
      "items": false
    },
    "inventoryDigest": {
      "$ref": "#/$defs/sha256"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "overallStatus": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue",
        "owner"
      ],
      "properties": {
        "issue": {
          "type": "string",
          "pattern": "^https://github\\.com/illusion-tech/laneflow/issues/[1-9][0-9]*$"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "overallStatus": {
            "const": "pass"
          }
        },
        "required": [
          "overallStatus"
        ]
      },
      "then": {
        "properties": {
          "assets": {
            "items": {
              "$ref": "#/$defs/passAsset"
            }
          }
        }
      },
      "else": {
        "properties": {
          "assets": {
            "contains": {
              "$ref": "#/$defs/failureAsset"
            },
            "minContains": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "gitObjectId": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repositoryInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "status",
        "locator",
        "digest"
      ],
      "properties": {
        "kind": {
          "const": "repository"
        },
        "status": {
          "const": "complete"
        },
        "locator": {
          "const": "git-ls-files-z:examples/data/*.json"
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "publishedInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "status",
        "scopeProfile",
        "channels",
        "assetCount",
        "locator",
        "digest",
        "decision"
      ],
      "properties": {
        "kind": {
          "const": "published"
        },
        "status": {
          "const": "complete"
        },
        "scopeProfile": {
          "const": "LF-CURRENT-PUBLISHED-INVENTORY-v1"
        },
        "channels": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {
              "const": "github-releases"
            },
            {
              "const": "installer-bundles"
            },
            {
              "const": "direct-user-delivery"
            }
          ],
          "items": false
        },
        "assetCount": {
          "const": 0
        },
        "locator": {
          "const": "repo:docs/design/current-package-import.md#13.1"
        },
        "digest": {
          "const": "5226af57e4d4d869f36b25b38b747f1e2d04820b93c3af11dff8dd00c3580ad3"
        },
        "decision": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "date",
            "authority",
            "fact"
          ],
          "properties": {
            "date": {
              "const": "2026-08-07"
            },
            "authority": {
              "const": "project-owner"
            },
            "fact": {
              "const": "no-current-json-ever-published-before-1.0"
            }
          }
        }
      }
    },
    "assetBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventoryKind",
        "path",
        "gitBlob",
        "byteLength",
        "sha256",
        "formatVersion",
        "formatVersionStatus",
        "pairingStatus",
        "expectedClassification",
        "actualClassification",
        "migrationOutcome",
        "diagnostics"
      ],
      "properties": {
        "inventoryKind": {
          "const": "repository"
        },
        "path": {
          "type": "string",
          "pattern": "^examples/data/[^\\r\\n]+\\.json$"
        },
        "gitBlob": {
          "$ref": "#/$defs/gitObjectId"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "formatVersion": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "formatVersionStatus": {
          "enum": [
            "parsed",
            "missing",
            "invalid-json",
            "invalid-type"
          ]
        },
        "pairingStatus": {
          "enum": [
            "paired",
            "unpaired",
            "not-applicable"
          ]
        },
        "expectedClassification": {
          "$ref": "#/$defs/expectedClassification"
        },
        "actualClassification": {
          "$ref": "#/$defs/actualClassification"
        },
        "migrationOutcome": {
          "enum": [
            "success",
            "expected-failure",
            "unhandled-failure"
          ]
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "formatVersionStatus": {
                "const": "parsed"
              }
            },
            "required": [
              "formatVersionStatus"
            ]
          },
          "then": {
            "properties": {
              "formatVersion": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "formatVersion": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "passAsset": {
      "allOf": [
        {
          "$ref": "#/$defs/assetBase"
        },
        {
          "oneOf": [
            {
              "$ref": "#/$defs/pairedSuccessAsset"
            },
            {
              "$ref": "#/$defs/unpairedTrafficAsset"
            },
            {
              "$ref": "#/$defs/unsupportedVersionAsset"
            }
          ]
        }
      ]
    },
    "failureAsset": {
      "allOf": [
        {
          "$ref": "#/$defs/assetBase"
        },
        {
          "type": "object",
          "properties": {
            "actualClassification": {
              "const": "migration-failure"
            },
            "migrationOutcome": {
              "const": "unhandled-failure"
            },
            "diagnostics": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "asset": {
      "oneOf": [
        {
          "$ref": "#/$defs/passAsset"
        },
        {
          "$ref": "#/$defs/failureAsset"
        }
      ]
    },
    "pairedSuccessAsset": {
      "type": "object",
      "properties": {
        "formatVersionStatus": {
          "const": "parsed"
        },
        "pairingStatus": {
          "const": "paired"
        },
        "expectedClassification": {
          "const": "paired-success"
        },
        "actualClassification": {
          "const": "paired-success"
        },
        "migrationOutcome": {
          "const": "success"
        },
        "diagnostics": {
          "maxItems": 0
        }
      }
    },
    "unpairedTrafficAsset": {
      "type": "object",
      "properties": {
        "formatVersionStatus": {
          "const": "parsed"
        },
        "pairingStatus": {
          "const": "unpaired"
        },
        "expectedClassification": {
          "const": "unpaired-traffic-only"
        },
        "actualClassification": {
          "const": "unpaired-traffic-only"
        },
        "migrationOutcome": {
          "const": "expected-failure"
        },
        "diagnostics": {
          "minItems": 1
        }
      }
    },
    "unsupportedVersionAsset": {
      "type": "object",
      "properties": {
        "formatVersionStatus": {
          "const": "parsed"
        },
        "pairingStatus": {
          "const": "not-applicable"
        },
        "expectedClassification": {
          "const": "unsupported-current-version"
        },
        "actualClassification": {
          "const": "unsupported-current-version"
        },
        "migrationOutcome": {
          "const": "expected-failure"
        },
        "diagnostics": {
          "minItems": 1
        }
      }
    },
    "expectedClassification": {
      "enum": [
        "paired-success",
        "unpaired-traffic-only",
        "unsupported-current-version"
      ]
    },
    "actualClassification": {
      "enum": [
        "paired-success",
        "unpaired-traffic-only",
        "unsupported-current-version",
        "migration-failure"
      ]
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "phase"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^LF-[A-Z0-9-]+$"
        },
        "phase": {
          "enum": [
            "inventory",
            "decode",
            "binding",
            "migration",
            "admission"
          ]
        },
        "document": {
          "enum": [
            "manifest",
            "traffic",
            "spatial"
          ]
        },
        "artifactRef": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^\\$"
        },
        "dimension": {
          "type": "string",
          "minLength": 1
        },
        "expected": {
          "type": "string"
        },
        "actual": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 0
        },
        "observed": {
          "type": "integer",
          "minimum": 0
        },
        "span": {
          "$ref": "#/$defs/span"
        }
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/position"
        },
        "end": {
          "$ref": "#/$defs/position"
        }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line",
        "column"
      ],
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
