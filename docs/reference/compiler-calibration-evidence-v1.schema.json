{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/illusion-tech/laneflow/blob/main/docs/reference/compiler-calibration-evidence-v1.schema.json",
  "title": "LaneFlow compiler calibration compact evidence v1",
  "description": "紧凑证据只绑定原始正式执行制品并保存独立重算结果；逐次运行记录只存在于 rawExecution 指向的原始 JSON。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "rawExecution",
    "source",
    "environment",
    "protocol",
    "coverage",
    "results"
  ],
  "properties": {
    "schema": {
      "const": "laneflow.compiler-calibration-evidence"
    },
    "schemaVersion": {
      "const": 1
    },
    "rawExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "schemaVersion",
        "path",
        "byteLength",
        "sha256"
      ],
      "properties": {
        "schema": {
          "const": "laneflow.compiler-calibration-formal-execution-checkpoint"
        },
        "schemaVersion": {
          "const": 10
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measurementCommit",
        "harnessCommit",
        "dirty",
        "cargoLockSha256",
        "contractDescriptorSha256",
        "workloadManifestSha256",
        "evidenceSchemaSha256",
        "binaries"
      ],
      "properties": {
        "measurementCommit": {
          "$ref": "#/$defs/gitCommit"
        },
        "harnessCommit": {
          "$ref": "#/$defs/gitCommit"
        },
        "dirty": {
          "const": false
        },
        "cargoLockSha256": {
          "$ref": "#/$defs/sha256"
        },
        "contractDescriptorSha256": {
          "$ref": "#/$defs/sha256"
        },
        "workloadManifestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "evidenceSchemaSha256": {
          "$ref": "#/$defs/sha256"
        },
        "binaries": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object"
          }
        }
      }
    },
    "environment": {
      "type": "object"
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "clockQuantumNs",
        "batchCount",
        "roundCountPerBatch"
      ],
      "properties": {
        "id": {
          "const": "compiler-calibration-v1"
        },
        "clockQuantumNs": {
          "type": "integer",
          "minimum": 1
        },
        "batchCount": {
          "const": 2
        },
        "roundCountPerBatch": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "processRunCount",
        "validRunCount",
        "invalidRunCount",
        "guardedRunCount",
        "baseScaleCount",
        "formalLadderCount",
        "completedFormalLevelCount",
        "limitPairCount",
        "candidateExecutionCount"
      ],
      "properties": {
        "processRunCount": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "validRunCount": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "invalidRunCount": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "guardedRunCount": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "baseScaleCount": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "formalLadderCount": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "completedFormalLevelCount": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "limitPairCount": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "candidateExecutionCount": {
          "$ref": "#/$defs/nonNegativeInteger"
        }
      }
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseScaleSelections",
        "formalLadders",
        "reproducibilityEnvelopes",
        "budgetRecommendations",
        "limitQualification",
        "candidateMatrix"
      ],
      "properties": {
        "currentFixtures": {
          "type": "object"
        },
        "baseScaleSelections": {
          "type": "array",
          "minItems": 1
        },
        "formalLadders": {
          "type": "array",
          "minItems": 1
        },
        "reproducibilityEnvelopes": {
          "type": "array",
          "minItems": 1
        },
        "budgetRecommendations": {
          "type": "array",
          "minItems": 1
        },
        "limitQualification": {
          "type": "object"
        },
        "candidateMatrix": {
          "type": "object"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    }
  }
}
