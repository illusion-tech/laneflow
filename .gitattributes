# Normalize all text files to LF in the repository and on checkout; binary
# files are auto-detected and left untouched.
* text=auto eol=lf

# #679 原始采集文件的摘要绑定实际字节。
research/issue-679-route-query/evidence/* -text

# #1184 原始 JSON 证据的摘要绑定采集字节，保留其换行形式。
research/issue-1184-lf-synth-workers/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Keep the checked-in flatc source canonical across platforms while preserving the
# generator's own trailing spaces and final blank line for clean regeneration.
crates/laneflow-road-editing-wire/src/generated/road-editing_generated.rs text eol=lf whitespace=-blank-at-eol,-blank-at-eof
