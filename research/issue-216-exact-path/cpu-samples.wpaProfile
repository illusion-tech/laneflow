<?xml version="1.0" encoding="utf-8"?>
<!-- CPU table/column identifiers follow the installed WPT AppLaunch profile.
     Keep individual samples, including timestamp and the complete stack. -->
<WpaProfileContainer xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" Version="2" xmlns="http://tempuri.org/SerializableElement.xsd">
  <Content xsi:type="WpaProfile2">
    <Sessions>
      <Session Index="0"><FileReferences /></Session>
    </Sessions>
    <Views>
      <View Guid="88e5af30-04c3-43eb-b339-6f0c74ec553e" Title="LaneFlow CPU samples" IsVisible="true">
        <Graphs>
          <Graph Guid="b855361e-7be0-4bc8-a754-3e8507715ca5" LayoutStyle="DataTable" Color="#FFFF0000" GraphHeight="300" IsShown="true">
            <Preset Name="LaneFlow raw samples" GraphColumnCount="9" KeyColumnCount="0" RightFrozenColumnCount="8" InitialFilterQuery="[Process Name]:~=runtime_profile_evidence" InitialFilterShouldKeep="true">
              <MetadataEntries>
                <MetadataEntry Guid="05100ece-df05-40c7-aad6-ffff99b60491" Name="Thread ID" ColumnMetadata="EndThreadId" />
                <MetadataEntry Guid="0bbf4299-0176-445e-b1d9-991df475d631" Name="TimeStamp" ColumnMetadata="StartTime" />
              </MetadataEntries>
              <HighlightEntries />
              <Columns>
                <Column Guid="9c1ceec3-ef4a-4865-b678-d774881187b9" Name="Process Name" SortPriority="1" Width="180" IsVisible="true" />
                <Column Guid="5b77e48f-6d24-4f29-8972-69c30e32f87d" Name="Process" SortPriority="2" Width="200" IsVisible="true" />
                <Column Guid="05100ece-df05-40c7-aad6-ffff99b60491" Name="Thread ID" SortPriority="3" Width="80" IsVisible="true" />
                <Column Guid="0bbf4299-0176-445e-b1d9-991df475d631" Name="TimeStamp" SortPriority="4" SortOrder="Ascending" Width="100" IsVisible="true" />
