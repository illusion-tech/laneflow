+//! #712 × #718 组合的直接观察（预集成补丁；依赖 #718 的 `cfg(test)` 钩子）。
+//!
+//! 三个断言族：真实分发后的来源读取与融合参照一致；本拍工作区已产生结果后
+//! 的失败只暴露旧已提交状态；失败后重试与直接成功一致。比较只经公开来源
+//! API 与状态摘要；分发证明用本阶段（P5 motion）本次调度的 dispatched_chunks。
+
+use std::num::NonZeroU32;
+use std::sync::Arc;
+
+use laneflow_format::{FormatLimits, check_canonical_network_input};
+use laneflow_static_contract::VehicleProfileOrdinal;
+use laneflow_static_network::{
+    SharedNetworkBuildLimits, SharedNetworkBuildOptions, SpatialBuildOption,
+    build_shared_network_revision,
+};
+
+use crate::kernel::tick::{drop_motion_slot_at, force_motion_dispatch, last_motion_dispatch_stats};
+use crate::{
+    CommittedNetworkSource, PublishedLfcaReference, RouteRegisterInput, TickInput, TrafficWorld,
+    VehicleSpawnInput, WorldConfig, WorldPolicySelection, deterministic_state_digest,
+};
+
+const FULL_SPATIAL: &[u8] = include_bytes!(
+    "../../../laneflow-compiler/tests/fixtures/portable/lfca-world-policies/full-spatial.lfca"
+);
+const WORKERS: u32 = 4;
+const VEHICLES: usize = 16;
+
+const LANES: usize = 16;
+
+fn revision() -> Arc<laneflow_static_network::SharedNetworkRevision> {
+    let limits = super::pose_source_compiler_shim::limits();
+    let keys: Vec<&'static str> = (0..LANES)
+        .map(|lane| super::pose_source_compiler_shim::leak_key(lane))
+        .collect();
+    super::pose_source_compiler_shim::build_revision(&limits, keys)
+}
+
+fn world(workers: u32, world_id: u64) -> TrafficWorld {
+    let revision = revision();
+    let origin = revision.canonical_origin();
+    let mut world = TrafficWorld::install(
+        Arc::clone(&revision),
+        WorldConfig::new(64, LANES as u32, 1_024, 1_024, 100),
+        crate::ExecutionConfig::new(NonZeroU32::new(workers).expect("nonzero workers")),
+        CommittedNetworkSource::Published {
+            reference: PublishedLfcaReference::new(
+                "fixture://pose-source-observation",
+                origin.canonical_artifact_digest(),
+                origin.canonical_artifact_byte_length(),
+                origin.network_revision(),
+            )
+            .expect("fixture key"),
+        },
+        world_id,
+        crate::test_policy::selection(&revision),
+    )
+    .expect("install");
+    // 每车道一条单边路线，每条路线生成一辆 Active；16 辆 ≥ 融合阈值 8。
+    for lane in 0..LANES {
+        let edge = super::pose_source_compiler_shim::edge_ordinal(&revision, lane);
+        let route = world
+            .register_route(RouteRegisterInput::new(vec![edge]))
+            .expect("lane route");
+        world
+            .spawn_vehicle(VehicleSpawnInput::new(
+                VehicleProfileOrdinal::from_raw(0),
+                route,
+                0,
+                1_000,
+                0,
+            ))
+            .expect("spawn");
+    }
+    world
+}
+
+fn sources(world: &TrafficWorld) -> Vec<(crate::VehicleHandle, crate::PoseSource)> {
+    world.committed_pose_sources().collect()
+}
+
+fn digest(world: &TrafficWorld) -> String {
+    format!(
+        "{:?}",
+        deterministic_state_digest(&world.capture_snapshot().expect("snapshot")).expect("digest")
+    )
+}
+
+/// 真实分发后成功读取：本次 step 的 P5 motion 分发包含多个块（真实并行
+/// 分发），随后来源序列与 worker=1 融合参照逐步一致。
+#[test]
+fn motion_dispatched_sources_match_fused_reference() {
+    let mut parallel = world(WORKERS, 731);
+    let mut fused = world(1, 731);
+
+    for _ in 0..4 {
+        let before = sources(&parallel);
+        let _dispatch = force_motion_dispatch();
+        parallel.step(TickInput::new(100)).expect("parallel step");
+        drop(_dispatch);
+        let stats = last_motion_dispatch_stats()
+            .expect("motion dispatch stats noted")
+            .dispatched_chunks;
+        assert!(
+            stats >= 2,
+            "this step must dispatch the motion stage in multiple chunks (got {stats})"
+        );
+        fused.step(TickInput::new(100)).expect("fused step");
+        assert_eq!(
+            before.len(),
+            sources(&parallel).len(),
+            "fleet size is stable in this window"
+        );
+        assert_eq!(
+            sources(&parallel),
+            sources(&fused),
+            "sources after real dispatch must match the fused reference"
+        );
+    }
+}
+
+/// 本拍工作区已产生 motion 结果后的失败：完成前沿不变量被检出，来源与
+/// 状态摘要保持调用前；解除注入后的重试与直接成功完全一致。
+#[test]
+fn staged_motion_failure_isolates_committed_then_retry_matches_clean() {
+    let mut failing = world(WORKERS, 732);
+    let mut clean = world(WORKERS, 732);
+    assert_eq!(sources(&failing), sources(&clean));
+
+    let before_sources = sources(&failing);
+    let before_digest = digest(&failing);
+
+    let error = {
+        let _gap = drop_motion_slot_at(0);
+        let _dispatch = force_motion_dispatch();
+        failing.step(TickInput::new(100))
+    }
+    .expect_err("staged workspace invariant must fail the tick");
+    // 完成前沿不变量在首错之前被协调器检出；具体变体随阶段而定，
+    // 这里断言失败确实来自本拍检出而非成功提交。
+    let _ = &error;
+    assert_eq!(
+        sources(&failing),
+        before_sources,
+        "failure must expose only the old committed sources"
+    );
+    assert_eq!(digest(&failing), before_digest);
+
+    {
+        let _dispatch = force_motion_dispatch();
+        clean.step(TickInput::new(100)).expect("clean step");
+    }
+    {
+        let _dispatch = force_motion_dispatch();
+        failing.step(TickInput::new(100)).expect("retry step");
+    }
+    assert_eq!(
+        sources(&failing),
+        sources(&clean),
+        "retry from the same initial state must equal the direct success"
+    );
+    assert_eq!(digest(&failing), digest(&clean));
+}
