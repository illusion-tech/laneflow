{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://illusion-tech.github.io/laneflow/schema/laneflow-data-v0.9.schema.json",
  "title": "LaneFlow Data Package v0.9",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "units",
    "laneGraph",
    "junctions",
    "movements",
    "maneuverPaths",
    "routes",
    "vehicleProfiles",
    "participantClasses",
    "facilityBands",
    "roadSections",
    "laneGroups",
    "roadCorridors",
    "accessRules",
    "signals",
    "parking"
  ],
  "properties": {
    "formatVersion": {
      "const": "0.9"
    },
    "units": {
      "$ref": "#/$defs/unitSpec"
    },
    "laneGraph": {
      "$ref": "#/$defs/laneGraph"
    },
    "junctions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/junction"
      }
    },
    "movements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/movement"
      }
    },
    "maneuverPaths": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/maneuverPath"
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/route"
      }
    },
    "vehicleProfiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/vehicleProfile"
      }
    },
    "participantClasses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/participantClass"
      }
    },
    "facilityBands": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/facilityBand"
      }
    },
    "roadSections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/roadSection"
      }
    },
    "laneGroups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/laneGroup"
      }
    },
    "roadCorridors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/roadCorridor"
      }
    },
    "accessRules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/accessRule"
      }
    },
    "signals": {
      "$ref": "#/$defs/signals"
    },
    "parking": {
      "$ref": "#/$defs/parking"
    },
    "extensions": {
      "type": "object"
    }
  },
  "$defs": {
    "externalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "portableMilliseconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positivePortableMilliseconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "unitSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distance",
        "time"
      ],
      "properties": {
        "distance": {
          "const": "meter"
        },
        "time": {
          "const": "second"
        }
      }
    },
    "laneGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edges"
      ],
      "properties": {
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/laneEdge"
          }
        }
      }
    },
    "laneEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "length",
        "speedLimit",
        "connections"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/externalId"
        },
        "length": {
          "type": "number",
          "exclusiveMinimum": 1e-9
        },
        "speedLimit": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "connections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/laneConnection"
          }
        }
      }
    },
    "laneConnection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "toEdgeId"
      ],
      "properties": {
        "toEdgeId": {
          "$ref": "#/$defs/externalId"
        }
      }
    },
    "junction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/externalId"
        }
      }
    },
    "movement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "junctionId"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/externalId"
        },
        "junctionId": {
          "$ref": "#/$defs/externalId"
        }
      }
    },
    "maneuverPath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "movementId",
        "entryEdgeId",
        "internalEdgeIds",
        "exitEdgeId"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/externalId"
        },
        "movementId": {
          "$ref": "#/$defs/externalId"
        },
        "entryEdgeId": {
          "$ref": "#/$defs/externalId"
        },
        "internalEdgeIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/externalId"
          }
        },
        "exitEdgeId": {
          "$ref": "#/$defs/externalId"
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "edgeIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/externalId"
        },
        "edgeIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/externalId"
          }
        }
      }
    },
    "vehicleProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "length",
        "model",
        "desiredSpeed",
        "minGap",
        "timeHeadway",
        "maxAcceleration",
        "comfortableDeceleration",
        "emergencyDeceleration",
        "participantClassId"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/externalId"
        },
        "length": {
          "type": "number",
          "exclusiveMinimum": 1e-9
        },
        "model": {
          "const": "iidm"
        },
        "desiredSpeed": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minGap": {
          "type": "number",
          "minimum": 0
        },
        "timeHeadway": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maxAcceleration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "comfortableDeceleration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "emergencyDeceleration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "participantClassId": {
          "$ref": "#/$defs/externalId"
        }
      }
    },
    "participantClass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/externalId"
        },
        "extendsId": {
          "$ref": "#/$defs/externalId"
        }
      }
    },
    "facilityKindId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "facilityBand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kindId"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/externalId"
        },
        "kindId": {
          "$ref": "#/$defs/facilityKindId"
        }
      }
    },
    "roadSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kindId",
        "lanes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/externalId"
        },
        "kindId": {
          "$ref": "#/$defs/facilityKindId"
        },
        "lanes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sectionLane"
          }
        }
      }
    },
    "sectionLane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edgeIds"
      ],
      "properties": {
        "edgeIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/externalId"
          }
        },
        "laneGroupId": {
          "$ref": "#/$defs/externalId"
        }
      }
    },
    "laneGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "roadSectionId"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/externalId"
        },
        "roadSectionId": {
          "$ref": "#/$defs/externalId"
        }
      }
    },
    "roadCorridor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "referenceSectionId",
        "elements"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/externalId"
        },
        "referenceSectionId": {
          "$ref": "#/$defs/externalId"
        },
        "elements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/corridorElement"
          }
        }
      }
    },
    "corridorElement": {
      "oneOf": [
        {
          "$ref": "#/$defs/corridorSectionElement"
        },
        {
          "$ref": "#/$defs/corridorBandElement"
        }
      ]
    },
    "corridorSectionElement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sectionId"
      ],
      "properties": {
        "sectionId": {
          "$ref": "#/$defs/externalId"
        }
      }
    },
    "corridorBandElement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bandId"
      ],
      "properties": {
        "bandId": {
          "$ref": "#/$defs/externalId"
        }
      }
    },
    "accessRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target",
        "effect",
        "participantClassIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/externalId"
        },
        "target": {
          "$ref": "#/$defs/accessTarget"
        },
        "effect": {
          "enum": [
            "allow",
            "deny"
          ]
        },
        "participantClassIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/externalId"
          }
        },
        "timeWindows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/timeWindow"
          }
        },
        "regulation": {
          "$ref": "#/$defs/regulation"
        },
        "priority": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        }
      }
    },
    "accessTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "laneEdge",
            "laneGroup",
            "roadSection",
            "maneuverPath",
            "facilityBand"
          ]
        },
        "id": {
          "$ref": "#/$defs/externalId"
        }
      }
    },
    "timeWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "days",
        "startMinuteOfDay",
        "endMinuteOfDay"
      ],
      "properties": {
        "days": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "mon",
              "tue",
              "wed",
              "thu",
              "fri",
              "sat",
              "sun"
            ]
          }
        },
        "startMinuteOfDay": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1439
        },
        "endMinuteOfDay": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        }
      }
    },
    "regulation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jurisdiction",
        "version"
      ],
      "properties": {
        "jurisdiction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "signals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stopLines",
        "maneuverGates",
        "groups",
        "controllers"
      ],
      "properties": {
        "stopLines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stopLine"
          }
        },
        "maneuverGates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/maneuverGate"
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/signalGroup"
          }
        },
        "controllers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/signalController"
          }
        }
      }
    },
    "parking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "areas",
        "spaces"
      ],
      "properties": {
        "areas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parkingArea"
          }
        },
        "spaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parkingSpace"
          }
        }
      }
    },
    "parkingArea": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/externalId"
        }
      }
    },
    "parkingSpace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "entry",
        "exit",
        "geometry"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/externalId"
        },
        "areaId": {
          "$ref": "#/$defs/externalId"
        },
        "entry": {
          "$ref": "#/$defs/parkingAnchor"
        },
        "exit": {
          "$ref": "#/$defs/parkingAnchor"
        },
        "geometry": {
          "$ref": "#/$defs/parkingGeometry"
        }
      }
    },
    "parkingAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edgeId",
        "progress"
      ],
      "properties": {
        "edgeId": {
          "$ref": "#/$defs/externalId"
        },
        "progress": {
          "type": "number",
          "exclusiveMinimum": 1e-9
        }
      }
    },
    "parkingGeometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lateralOffset",
        "headingOffsetRadians",
        "length",
        "width"
      ],
      "properties": {
        "lateralOffset": {
          "type": "number",
          "anyOf": [
            {
              "exclusiveMaximum": -1e-9
            },
            {
              "exclusiveMinimum": 1e-9
            }
          ]
        },
        "headingOffsetRadians": {
          "type": "number",
          "minimum": -3.141592653589793,
          "exclusiveMaximum": 3.141592653589793
        },
        "length": {
          "type": "number",
          "exclusiveMinimum": 1e-9
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 1e-9
        }
      }
    },
    "stopLine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "edgeId",
        "location"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/externalId"
        },
        "edgeId": {
          "$ref": "#/$defs/externalId"
        },
        "location": {
          "const": "edgeEnd"
        }
      }
    },
    "maneuverGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "maneuverPathId",
        "transitionIndex",
        "stopLineId",
        "signalControl"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/externalId"
        },
        "maneuverPathId": {
          "$ref": "#/$defs/externalId"
        },
        "transitionIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "stopLineId": {
          "$ref": "#/$defs/externalId"
        },
        "signalControl": {
          "oneOf": [
            {
              "$ref": "#/$defs/groupSignalControl"
            },
            {
              "$ref": "#/$defs/noneSignalControl"
            }
          ]
        }
      }
    },
    "groupSignalControl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "groupId"
      ],
      "properties": {
        "kind": {
          "const": "group"
        },
        "groupId": {
          "$ref": "#/$defs/externalId"
        }
      }
    },
    "noneSignalControl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "none"
        }
      }
    },
    "signalGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/externalId"
        }
      }
    },
    "signalController": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "offsetMs",
        "groupIds",
        "phases"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/externalId"
        },
        "kind": {
          "const": "fixedTime"
        },
        "offsetMs": {
          "$ref": "#/$defs/portableMilliseconds"
        },
        "groupIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/externalId"
          }
        },
        "phases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/signalPhase"
          }
        }
      }
    },
    "signalPhase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "durationMs",
        "states"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/externalId"
        },
        "durationMs": {
          "$ref": "#/$defs/positivePortableMilliseconds"
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/signalGroupState"
          }
        }
      }
    },
    "signalGroupState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "groupId",
        "aspect"
      ],
      "properties": {
        "groupId": {
          "$ref": "#/$defs/externalId"
        },
        "aspect": {
          "enum": [
            "red",
            "yellow",
            "green"
          ]
        }
      }
    }
  }
}
