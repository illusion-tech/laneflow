// LaneFlow 运行时快照容器 v5。
// v5 加入策略选择、Conflict 资格/reservation/lag history 与 Clearing；派生
// queue link、occupancy index、frontier、latest decision/event batch 和 tick-local claim 不持久化。

namespace LaneFlow.RuntimeSnapshot.V5;

struct Digest256 { bytes:[ubyte:32]; }
struct StableId128 { bytes:[ubyte:16]; }

struct StaticContractVersionSet {
  canonical_format_version:ushort;
  identity_encoding_version:ushort;
  identity_registry_revision:ushort;
  network_revision_derivation_version:ushort;
  constraint_contract_version:ushort;
  static_execution_contract_version:ushort;
}

enum SourceKind:ubyte { Unspecified = 0, Published = 1 }
enum VehicleStatusKind:ubyte { Unspecified = 0, Active = 1, Parked = 2, Completed = 3 }
enum ParkingBindingStateKind:ubyte { Unspecified = 0, Reserved = 1, Occupied = 2 }
enum ParkingTargetKind:ubyte { Unspecified = 0, ExplicitSpace = 1, VirtualPool = 2 }
enum ManeuverTraversalPhaseKind:ubyte {
  Unspecified = 0,
  PreGate = 1,
  Committed = 2,
  Waiting = 3,
  Clearing = 4
}

enum WorldPolicySelectionKind:ubyte { Unspecified = 0, NotRequired = 1, Pinned = 2 }
enum ConflictLagReferenceKind:ubyte {
  Unspecified = 0,
  ActualClear = 1,
  CutoverFloor = 2
}

table WorldPolicyBinding {
  selection:WorldPolicySelectionKind;
  policy:StableId128;
}

table WorldConfigBinding {
  vehicle_capacity:uint;
  route_capacity:uint;
  route_edge_occurrence_capacity:ulong;
  route_conflict_occurrence_capacity:ulong;
  worker_count:uint;
  fixed_delta_time_ms:ulong;
}

table PublishedSourceBinding {
  asset_key:string (required);
  artifact_digest:Digest256;
  artifact_byte_length:ulong;
  network_revision:Digest256;
}

table SnapshotRoute {
  snapshot_route_id:ulong;
  edges:[StableId128] (required);
}

// target is ParkingSpace StableId for ExplicitSpace and ParkingFacility StableId for
// VirtualPool. Reserved VirtualPool additionally requires the exact semantic entry pair.
table ParkingBinding {
  state:ParkingBindingStateKind;
  target_kind:ParkingTargetKind;
  target:StableId128;
  entry_route_occurrence:uint;
  virtual_entry_edge:StableId128;
  virtual_entry_progress_mm:uint;
}

// phase_gate is the stable identity of next/last/release Gate according to phase.
table ManeuverTraversalBinding {
  maneuver_occurrence_index:uint;
  maneuver_path:StableId128;
  phase:ManeuverTraversalPhaseKind;
  phase_gate:StableId128;
}

table WaitingMembershipBinding {
  waiting_zone:StableId128;
  maneuver_occurrence_index:uint;
  entry_gate:StableId128;
  release_gate:StableId128;
  admission_sequence:ulong;
}

// 持久化 locator 只含跨修订稳定身份，不写 Runtime ordinal/local index。
table ConflictPassageLocatorBinding {
  participant_stream:StableId128;
  conflict_zone:StableId128;
}

// 精确 Gate arrival occurrence；first_eligible_tick=0 是合法历史。
table ConflictEligibilityBinding {
  maneuver_occurrence_index:uint;
  maneuver_entry_route_edge_index:uint;
  admission_gate:StableId128;
  conflict_occurrence_index:uint;
  passage:ConflictPassageLocatorBinding (required);
  first_eligible_tick:ulong;
}

// reservation 中一次 route passage occurrence 的稳定身份与物理锚点。
table ConflictPassageBinding {
  conflict_occurrence_index:uint;
  passage:ConflictPassageLocatorBinding (required);
  entry_route_edge_index:uint;
  entry_progress_mm:uint;
  clearance_route_edge_index:uint;
  clearance_progress_mm:uint;
}

// 保留实际已提交的物理 claim 并集。route occurrence、owner 顺序与车型间距均由
// reservation exact route/Gate/passages 和被绑定 LFCA 重新推导，不在每个区间重复保存。
table ConflictDownstreamIntervalBinding {
  lane_edge:StableId128;
  start_mm:uint;
  end_mm:uint;
}

table ConflictReservationBinding {
  acquired_tick:ulong;
  maneuver_occurrence_index:uint;
  maneuver_entry_route_edge_index:uint;
  admission_gate:StableId128;
  passages:[ConflictPassageBinding] (required);
  downstream_intervals:[ConflictDownstreamIntervalBinding] (required);
}

// 只允许 ActualClear/CutoverFloor；NoHistory 不写行。
table ConflictLagState {
  passage:ConflictPassageLocatorBinding (required);
  reference_kind:ConflictLagReferenceKind;
  reference_time_ms:ulong;
}

table SnapshotVehicle {
  snapshot_vehicle_id:ulong;
  snapshot_route_id:ulong;
  route_edge_index:uint;
  progress_mm:uint;
  carry_um:ushort;
  speed_mm_s:uint;
  status:VehicleStatusKind;
  profile:StableId128;
  class:StableId128;
  parking:ParkingBinding;
  maneuver_traversal:ManeuverTraversalBinding;
  waiting_membership:WaitingMembershipBinding;
  conflict_eligibility:ConflictEligibilityBinding;
  conflict_reservation:ConflictReservationBinding;
}

// occupancy is serialized defensively and must equal the reconstructed member count.
// A zero-occupancy row remains required whenever next_admission_sequence is non-zero.
table WaitingZoneState {
  waiting_zone:StableId128;
  occupancy:uint;
  next_admission_sequence:ulong;
}

table RuntimeSnapshot {
  format_version:uint;
  runtime_state_version:ushort;
  world_id:ulong;
  tick:ulong;
  time_ms:ulong;
  command_cursor:ulong;
  event_cursor:ulong;
  world_config:WorldConfigBinding (required);
  network_revision:Digest256;
  lfca_artifact_digest:Digest256;
  lfca_artifact_byte_length:ulong;
  static_contract_versions:StaticContractVersionSet;
  source_kind:SourceKind;
  source_published:PublishedSourceBinding;
  routes:[SnapshotRoute] (required);
  vehicles:[SnapshotVehicle] (required);
  live_order:[ulong] (required);
  waiting_zones:[WaitingZoneState] (required);
  world_policy:WorldPolicyBinding (required);
  conflict_lag_states:[ConflictLagState] (required);
}

root_type RuntimeSnapshot;
file_identifier "LFRS";
file_extension "lfrs";
